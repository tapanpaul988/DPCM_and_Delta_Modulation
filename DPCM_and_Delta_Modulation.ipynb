# ============================================================
# 9. SLOPE OVERLOAD TEST
# ============================================================

def slope_overload_percentage(x, step):

    change = np.abs(np.diff(x))

    percentage = (
        np.sum(change > step)
        / len(change)
    ) * 100

    return percentage


slope_slow = slope_overload_percentage(
    x_slow,
    test_step
)

slope_fast = slope_overload_percentage(
    x_fast,
    test_step
)


